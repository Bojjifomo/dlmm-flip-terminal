{
  "name": "meteora-bidask-flip",
  "version": "0.1.0",
  "private": true,
  "description": "Auto-flip Meteora DLMM positions with a one-sided bid-ask strategy.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "meteora-flip": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "status": "tsx src/cli.ts status --config config/sample.config.yaml",
    "dry-run": "tsx src/cli.ts run --config config/sample.config.yaml --mode dry-run --once"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.0",
    "@meteora-ag/dlmm": "1.9.14",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.95.8",
    "bn.js": "5.2.2",
    "commander": "12.1.0",
    "decimal.js": "10.6.0",
    "dotenv": "16.4.7",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/node": "22.15.21",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vitest": "3.1.4"
  }
}
